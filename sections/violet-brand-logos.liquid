{{ 'violet-cms-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logos = shop.metafields.violet.brand_logos.value
  assign max_items = section.settings.max_items
-%}

{%- if logos != blank -%}
  <div class="violet-section violet-section--separator-{{ section.settings.separator }} violet-section--visible-{{ section.settings.visibility }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width violet-section__inner violet-section__inner--{{ section.settings.section_width }} violet-section__inner--align-{{ section.settings.content_alignment }}" style="--violet-padding-top: {{ section.settings.padding_top }}px; --violet-padding-bottom: {{ section.settings.padding_bottom }}px;">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="violet-section__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="violet-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="violet-section__title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="violet-logo-list">
        {%- for logo in logos limit: max_items -%}
          {%- assign image = logo.image.value -%}
          {%- assign url = logo.url.value -%}
          <div class="violet-logo-list__item">
            {%- if url != blank -%}
              <a href="{{ url }}" aria-label="{{ logo.alt.value | default: image.alt | escape }}">
            {%- endif -%}
            {%- if image != blank -%}
              {{ image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', alt: logo.alt.value | default: image.alt }}
            {%- endif -%}
            {%- if url != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Violet: logos de marca",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Violet CMS" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Marcas y colaboraciones" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Medio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h2"
    },
    { "type": "range", "id": "max_items", "min": 2, "max": 12, "step": 1, "label": "Máximo de logos", "default": 8 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "header", "content": "Violet layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "narrow", "label": "Estrecho" },
        { "value": "page", "label": "Normal" },
        { "value": "wide", "label": "Ancho" },
        { "value": "full", "label": "Completo" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Linea separadora",
      "options": [
        { "value": "none", "label": "Sin linea" },
        { "value": "top", "label": "Arriba" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "both", "label": "Arriba y abajo" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibilidad",
      "options": [
        { "value": "all", "label": "Móvil y escritorio" },
        { "value": "mobile", "label": "Solo móvil" },
        { "value": "desktop", "label": "Solo escritorio" }
      ],
      "default": "all"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding superior", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding inferior", "default": 40 }
  ],
  "presets": [
    { "name": "Violet: logos de marca" }
  ]
}
{% endschema %}
