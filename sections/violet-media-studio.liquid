{{ 'violet-cms-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign poster = section.settings.poster
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_3 = section.settings.image_3
-%}

<div class="violet-section violet-media-studio violet-section--separator-{{ section.settings.separator }} violet-section--visible-{{ section.settings.visibility }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width violet-section__inner violet-section__inner--{{ section.settings.section_width }} violet-section__inner--align-{{ section.settings.content_alignment }}" style="--violet-padding-top: {{ section.settings.padding_top }}px; --violet-padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="violet-media-studio__layout">
      <div class="violet-media-studio__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="violet-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="violet-section__title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="violet-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="violet-media-studio__video" aria-label="{{ section.settings.video_label | escape }}">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          {% if poster != blank %}
            poster="{{ poster | image_url: width: 1400 }}"
          {% else %}
            poster="{{ 'violet-demo-escotilla.png' | asset_url }}"
          {% endif %}
        >
          <source src="{{ 'violet-demo-video.mp4' | asset_url }}" type="video/mp4">
        </video>
      </div>
    </div>

    <div class="violet-media-studio__cards">
      <a class="violet-media-card" href="{{ section.settings.card_1_link | default: routes.all_products_collection_url }}">
        {%- if image_1 != blank -%}
          {{ image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: image_1.alt }}
        {%- else -%}
          <img src="{{ 'violet-demo-escotilla.png' | asset_url }}" alt="" width="900" height="900" loading="lazy">
        {%- endif -%}
        <span>
          <strong>{{ section.settings.card_1_title | escape }}</strong>
          <small>{{ section.settings.card_1_text | escape }}</small>
        </span>
      </a>

      <a class="violet-media-card" href="{{ section.settings.card_2_link | default: routes.all_products_collection_url }}">
        {%- if image_2 != blank -%}
          {{ image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: image_2.alt }}
        {%- else -%}
          <img src="{{ 'violet-demo-gibraltar.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
        {%- endif -%}
        <span>
          <strong>{{ section.settings.card_2_title | escape }}</strong>
          <small>{{ section.settings.card_2_text | escape }}</small>
        </span>
      </a>

      <a class="violet-media-card" href="{{ section.settings.card_3_link | default: routes.all_products_collection_url }}">
        {%- if image_3 != blank -%}
          {{ image_3 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: image_3.alt }}
        {%- else -%}
          <img src="{{ 'violet-demo-historia.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
        {%- endif -%}
        <span>
          <strong>{{ section.settings.card_3_title | escape }}</strong>
          <small>{{ section.settings.card_3_text | escape }}</small>
        </span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Violet: multimedia",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Violet media" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Una tienda con imagen, movimiento y relato" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Una zona para probar como respira Violet con video, imágenes editoriales y enlaces comerciales sin depender de un traspaso completo.</p>" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Medio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver productos" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón", "default": "/collections/all" },
    { "type": "image_picker", "id": "poster", "label": "Poster del video" },
    { "type": "text", "id": "video_label", "label": "Etiqueta accesible del video", "default": "Video editorial Violet" },
    { "type": "image_picker", "id": "image_1", "label": "Imagen tarjeta 1" },
    { "type": "text", "id": "card_1_title", "label": "Título tarjeta 1", "default": "La Escotilla" },
    { "type": "text", "id": "card_1_text", "label": "Texto tarjeta 1", "default": "Marca, portada y atmosfera visual" },
    { "type": "url", "id": "card_1_link", "label": "Enlace tarjeta 1", "default": "/collections/all" },
    { "type": "image_picker", "id": "image_2", "label": "Imagen tarjeta 2" },
    { "type": "text", "id": "card_2_title", "label": "Título tarjeta 2", "default": "Historias ilustradas" },
    { "type": "text", "id": "card_2_text", "label": "Texto tarjeta 2", "default": "Contenido editorial con aire propio" },
    { "type": "url", "id": "card_2_link", "label": "Enlace tarjeta 2", "default": "/collections/all" },
    { "type": "image_picker", "id": "image_3", "label": "Imagen tarjeta 3" },
    { "type": "text", "id": "card_3_title", "label": "Título tarjeta 3", "default": "Colecciones con mundo" },
    { "type": "text", "id": "card_3_text", "label": "Texto tarjeta 3", "default": "Imágenes que hacen que el producto tenga contexto" },
    { "type": "url", "id": "card_3_link", "label": "Enlace tarjeta 3", "default": "/collections/all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "header", "content": "Violet layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "narrow", "label": "Estrecho" },
        { "value": "page", "label": "Normal" },
        { "value": "wide", "label": "Ancho" },
        { "value": "full", "label": "Completo" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Linea separadora",
      "options": [
        { "value": "none", "label": "Sin linea" },
        { "value": "top", "label": "Arriba" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "both", "label": "Arriba y abajo" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibilidad",
      "options": [
        { "value": "all", "label": "Móvil y escritorio" },
        { "value": "mobile", "label": "Solo móvil" },
        { "value": "desktop", "label": "Solo escritorio" }
      ],
      "default": "all"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding superior", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding inferior", "default": 52 }
  ],
  "presets": [
    { "name": "Violet: multimedia" }
  ]
}
{% endschema %}
