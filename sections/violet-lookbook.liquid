{{ 'violet-cms-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign items = shop.metafields.violet.lookbook.value
  assign max_items = section.settings.max_items
-%}

{%- if items != blank -%}
  <div class="violet-section violet-section--separator-{{ section.settings.separator }} violet-section--visible-{{ section.settings.visibility }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width violet-section__inner violet-section__inner--{{ section.settings.section_width }} violet-section__inner--align-{{ section.settings.content_alignment }}" style="--violet-padding-top: {{ section.settings.padding_top }}px; --violet-padding-bottom: {{ section.settings.padding_bottom }}px;">
      <div class="violet-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="violet-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="violet-section__title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="violet-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="violet-lookbook">
        {%- for item in items limit: max_items -%}
          {%- liquid
            assign image = item.image.value
            assign product = item.product.value
            assign collection = item.collection.value
            assign cta_label = item.cta_label.value
            assign cta_url = item.cta_url.value
            assign item_url = cta_url
            if item_url == blank and product != blank
              assign item_url = product.url
            elsif item_url == blank and collection != blank
              assign item_url = collection.url
            endif
          -%}
          <article class="violet-lookbook__item">
            {%- if image != blank -%}
              <div class="violet-lookbook__media">
                {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1200, 1400', alt: image.alt }}
              </div>
            {%- endif -%}

            <div class="violet-lookbook__content">
              {%- if item.label.value != blank -%}
                <p class="violet-section__eyebrow">{{ item.label.value | escape }}</p>
              {%- endif -%}
              {%- if item.title.value != blank -%}
                <h3 class="violet-card__title h2">{{ item.title.value | escape }}</h3>
              {%- endif -%}
              {%- if item.text.value != blank -%}
                <div class="violet-card__text rte">{{ item.text.value | newline_to_br }}</div>
              {%- endif -%}

              {%- if item_url != blank and cta_label != blank -%}
                <a class="button button--secondary" href="{{ item_url }}">{{ cta_label | escape }}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Violet: lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Lookbook" },
    { "type": "inline_richtext", "id": "heading", "label": "Titulo", "default": "Inspiracion para explorar" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamano del titulo",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Medio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "range", "id": "max_items", "min": 1, "max": 8, "step": 1, "label": "Maximo de piezas", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "header", "content": "Violet layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de seccion",
      "options": [
        { "value": "narrow", "label": "Estrecho" },
        { "value": "page", "label": "Normal" },
        { "value": "wide", "label": "Ancho" },
        { "value": "full", "label": "Completo" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineacion del contenido",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Linea separadora",
      "options": [
        { "value": "none", "label": "Sin linea" },
        { "value": "top", "label": "Arriba" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "both", "label": "Arriba y abajo" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibilidad",
      "options": [
        { "value": "all", "label": "Movil y escritorio" },
        { "value": "mobile", "label": "Solo movil" },
        { "value": "desktop", "label": "Solo escritorio" }
      ],
      "default": "all"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding superior", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding inferior", "default": 52 }
  ],
  "presets": [
    { "name": "Violet: lookbook" }
  ]
}
{% endschema %}
