{{ 'violet-cms-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign finder_collection = section.settings.collection
  if finder_collection == blank
    assign finder_collection = collections['all']
  endif
  assign finder_url = finder_collection.url | default: routes.all_products_collection_url
-%}

<div class="violet-section violet-gift-finder violet-section--separator-{{ section.settings.separator }} violet-section--visible-{{ section.settings.visibility }} color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width violet-section__inner violet-section__inner--{{ section.settings.section_width }}"
    style="--violet-padding-top: {{ section.settings.padding_top }}px; --violet-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="violet-gift-finder__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="violet-section__title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="violet-section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ul class="violet-gift-finder__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign band_url = finder_url | append: '?sort_by=price-ascending'
          if block.settings.min_price != blank and block.settings.min_price > 0
            assign band_url = band_url | append: '&filter.v.price.gte=' | append: block.settings.min_price
          endif
          if block.settings.max_price != blank and block.settings.max_price > 0
            assign band_url = band_url | append: '&filter.v.price.lte=' | append: block.settings.max_price
          endif
        -%}
        <li class="violet-gift-finder__item" {{ block.shopify_attributes }}>
          <a class="violet-gift-tag" href="{{ band_url }}">
            {%- if block.settings.image != blank -%}
              <span class="violet-gift-tag__media">
                {{
                  block.settings.image
                  | image_url: width: 480
                  | image_tag: loading: 'lazy', widths: '160, 240, 360, 480', alt: block.settings.label
                }}
              </span>
            {%- else -%}
              <span class="violet-gift-tag__label">
                <span class="violet-gift-tag__hole" aria-hidden="true"></span>
                {{ block.settings.label | escape }}
              </span>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <span class="violet-gift-tag__caption">{{ block.settings.caption | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Violet: regalos x precio",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "¿Buscas un regalo?" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Medio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Elige el presupuesto y te enseñamos lo que encaja.</p>" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección donde buscar",
      "info": "Vacío: todo el catálogo. El filtro de precio usa los filtros de la tienda (Search & Discovery)."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "header", "content": "Diseño" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page", "label": "Página" },
        { "value": "narrow", "label": "Estrecho" },
        { "value": "full", "label": "Completo" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separador",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "top", "label": "Arriba" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "both", "label": "Arriba y abajo" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibilidad",
      "options": [
        { "value": "all", "label": "Móvil y escritorio" },
        { "value": "desktop", "label": "Solo escritorio" },
        { "value": "mobile", "label": "Solo móvil" }
      ],
      "default": "all"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding superior", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding inferior", "default": 52 }
  ],
  "blocks": [
    {
      "type": "band",
      "name": "Rango de precio",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Hasta 25 €" },
        { "type": "number", "id": "min_price", "label": "Precio mínimo (€)", "info": "Vacío o 0: sin mínimo." },
        { "type": "number", "id": "max_price", "label": "Precio máximo (€)", "info": "Vacío o 0: sin máximo." },
        { "type": "text", "id": "caption", "label": "Texto bajo la etiqueta" },
        { "type": "image_picker", "id": "image", "label": "Imagen propia (sustituye a la etiqueta)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Violet: regalos x precio",
      "blocks": [
        { "type": "band", "settings": { "label": "Hasta 25 €", "max_price": 25 } },
        { "type": "band", "settings": { "label": "De 25 a 35 €", "min_price": 25, "max_price": 35 } },
        { "type": "band", "settings": { "label": "De 35 a 45 €", "min_price": 35, "max_price": 45 } },
        { "type": "band", "settings": { "label": "Más de 45 €", "min_price": 45 } }
      ]
    }
  ]
}
{% endschema %}
