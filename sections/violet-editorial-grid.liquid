{{ 'violet-cms-sections.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="violet-section violet-section--separator-{{ section.settings.separator }} violet-section--visible-{{ section.settings.visibility }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width violet-section__inner violet-section__inner--{{ section.settings.section_width }} violet-section__inner--align-{{ section.settings.content_alignment }}" style="--violet-padding-top: {{ section.settings.padding_top }}px; --violet-padding-bottom: {{ section.settings.padding_bottom }}px;">
      <div class="violet-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="violet-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="violet-section__title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="violet-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="violet-card-grid violet-card-grid--{{ section.settings.columns_desktop }}">
        {%- for block in section.blocks -%}
          <article class="violet-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="violet-card__media">
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', alt: block.settings.image.alt
                }}
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="violet-card__title h3">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="violet-card__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                class="button button--secondary"
                {% if block.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Violet: editorial",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Violet" },
    { "type": "inline_richtext", "id": "heading", "label": "Titulo", "default": "Una entrada mas editorial" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamano del titulo",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Medio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "header", "content": "Violet layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de seccion",
      "options": [
        { "value": "narrow", "label": "Estrecho" },
        { "value": "page", "label": "Normal" },
        { "value": "wide", "label": "Ancho" },
        { "value": "full", "label": "Completo" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineacion del contenido",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Linea separadora",
      "options": [
        { "value": "none", "label": "Sin linea" },
        { "value": "top", "label": "Arriba" },
        { "value": "bottom", "label": "Abajo" },
        { "value": "both", "label": "Arriba y abajo" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibilidad",
      "options": [
        { "value": "all", "label": "Movil y escritorio" },
        { "value": "mobile", "label": "Solo movil" },
        { "value": "desktop", "label": "Solo escritorio" }
      ],
      "default": "all"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding superior", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding inferior", "default": 52 }
  ],
  "blocks": [
    {
      "type": "editorial_card",
      "name": "Tarjeta editorial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "inline_richtext", "id": "title", "label": "Titulo", "default": "Bloque editorial" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cuenta una historia, destaca una coleccion o guia al comprador.</p>" },
        { "type": "text", "id": "button_label", "label": "Texto del boton" },
        { "type": "url", "id": "button_link", "label": "Enlace del boton" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Violet: editorial",
      "blocks": [
        { "type": "editorial_card" },
        { "type": "editorial_card" },
        { "type": "editorial_card" }
      ]
    }
  ]
}
{% endschema %}
