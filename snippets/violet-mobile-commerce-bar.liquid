{% comment %}
  Violet CMS — Mobile commerce bar.
  Reuses Dawn menu/search/cart/account endpoints instead of duplicating drawers.
{% endcomment %}

<nav class="violet-mobile-bar{% unless section.settings.violet_mobile_bar_show_labels %} violet-mobile-bar--icons-only{% endunless %}{% unless section.settings.violet_mobile_bar_show_account %} violet-mobile-bar--three-items{% endunless %}" aria-label="{{ 'violet.navigation.mobile_bar' | t }}">
  <button
    class="violet-mobile-bar__item"
    type="button"
    data-violet-mobile-menu
  >
    <span class="svg-wrapper">{{ 'icon-hamburger.svg' | inline_asset_content }}</span>
    {%- if section.settings.violet_mobile_bar_show_labels -%}
      <span>{{ 'sections.header.menu' | t }}</span>
    {%- endif -%}
  </button>

  <button
    class="violet-mobile-bar__item"
    type="button"
    data-violet-mobile-search
  >
    <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
    {%- if section.settings.violet_mobile_bar_show_labels -%}
      <span>{{ 'general.search.search' | t }}</span>
    {%- endif -%}
  </button>

  <a class="violet-mobile-bar__item" href="{{ routes.cart_url }}">
    <span class="violet-mobile-bar__icon">
      <span class="svg-wrapper">
        {%- if cart == empty -%}
          {{ 'icon-cart-empty.svg' | inline_asset_content }}
        {%- else -%}
          {{ 'icon-cart.svg' | inline_asset_content }}
        {%- endif -%}
      </span>
      {%- if cart != empty -%}
        <span class="violet-mobile-bar__count" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
    </span>
    {%- if section.settings.violet_mobile_bar_show_labels -%}
      <span>{{ 'templates.cart.cart' | t }}</span>
    {%- endif -%}
    {%- if cart != empty -%}
      <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
    {%- endif -%}
  </a>

  {%- if section.settings.violet_mobile_bar_show_account -%}
    <a
      class="violet-mobile-bar__item"
      href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
      rel="nofollow"
    >
      <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
      {%- if section.settings.violet_mobile_bar_show_labels -%}
        <span>
          {%- liquid
            if customer
              echo 'customer.account_fallback' | t
            else
              echo 'customer.log_in' | t
            endif
          -%}
        </span>
      {%- endif -%}
    </a>
  {%- endif -%}
</nav>
