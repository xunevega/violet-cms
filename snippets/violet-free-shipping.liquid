{% comment %}
  Violet CMS — Free shipping progress.
  Uses shop.metafields.violet.free_shipping_threshold as a decimal amount.
{% endcomment %}
{{ 'violet-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign threshold = shop.metafields.violet.free_shipping_threshold.value | default: shop.metafields.violet.free_shipping_threshold
  assign threshold_cents = threshold | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
  assign progress = 0
  if threshold_cents > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
  endif
  if progress > 100
    assign progress = 100
  endif
  if progress < 0
    assign progress = 0
  endif
  if remaining < 0
    assign remaining = 0
  endif
  assign remaining_money = remaining | money
-%}

{%- if cart != empty and threshold_cents > 0 -%}
  <div class="violet-cart-panel violet-free-shipping">
    {%- if remaining > 0 -%}
      <p class="violet-free-shipping__text">
        {{ 'violet.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      </p>
    {%- else -%}
      <p class="violet-free-shipping__text">
        {{ 'violet.cart.free_shipping_success' | t }}
      </p>
    {%- endif -%}
    <div class="violet-free-shipping__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
      <span class="violet-free-shipping__bar" style="--violet-shipping-progress: {{ progress }}%;"></span>
    </div>
  </div>
{%- endif -%}
