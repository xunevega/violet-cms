{% comment %}
  Violet CMS — Materiales y cuidados.
  Accepts: product, block, section_id
{% endcomment %}
{%- liquid
  assign materials = product.metafields.violet.materials.value
  assign care = product.metafields.violet.care.value
-%}
{%- if materials != blank or care != blank -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-MaterialsCare-{{ block.id }}-{{ section_id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: 'ruler' %}
          <h2 class="h4 accordion__title inline-richtext">
            {{ block.settings.materials_heading | default: 'Materiales y cuidados' }}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-MaterialsCare-{{ block.id }}-{{ section_id }}">
        {%- if materials != blank -%}
          <ul>
            {%- for material in materials -%}
              <li>{{ material }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if care != blank -%}
          <p>{{ care | newline_to_br }}</p>
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}
