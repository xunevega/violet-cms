{% comment %}
  Violet CMS — Historia del producto e Inspiración.
  Accepts: product, block, section_id
{% endcomment %}
{%- liquid
  assign story = product.metafields.violet.story.value
  assign inspiration = product.metafields.violet.inspiration.value
-%}
{%- if story != blank -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-Story-{{ block.id }}-{{ section_id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: 'heart' %}
          <h2 class="h4 accordion__title inline-richtext">
            {{ block.settings.story_heading | default: 'Historia del producto' }}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-Story-{{ block.id }}-{{ section_id }}">
        {{ product.metafields.violet.story | metafield_tag }}
      </div>
    </details>
  </div>
{%- endif -%}
{%- if inspiration != blank -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-Inspiration-{{ block.id }}-{{ section_id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: 'star' %}
          <h2 class="h4 accordion__title inline-richtext">
            {{ block.settings.inspiration_heading | default: 'Inspiración' }}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-Inspiration-{{ block.id }}-{{ section_id }}">
        {{ product.metafields.violet.inspiration | metafield_tag }}
      </div>
    </details>
  </div>
{%- endif -%}
